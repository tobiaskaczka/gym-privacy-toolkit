# Python bytecode/cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Test/coverage/tool caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Build/package artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Local IDE/editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Local runtime outputs (keep generated videos out of git)
output/*
!output/.gitkeep
outputs/
tmp/

# Agents
AGENTS.md
